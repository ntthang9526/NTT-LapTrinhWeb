@model Blog
@{ ViewData["Title"] = "Xóa bài viết"; }
<div class="card"><div class="card-body">
<p class="text-danger">Bạn có chắc muốn xóa bản ghi này?</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<partial name="_Details" model="Model" />
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xác nhận xóa</button> <a asp-action="Index" class="btn btn-secondary">Hủy</a></form>
</div></div>
