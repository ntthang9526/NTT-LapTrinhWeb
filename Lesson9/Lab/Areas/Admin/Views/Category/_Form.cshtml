@model Category
<div class="form-group"><label asp-for="Name"></label><input asp-for="Name" type="text" maxlength="100" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="form-group"><label asp-for="Status"></label><select asp-for="Status" class="form-control"><option value="1">Hiển thị</option><option value="0">Ẩn</option></select><span asp-validation-for="Status" class="text-danger"></span></div><div class="form-group"><label asp-for="Image"></label><input asp-for="Image" type="text" maxlength="100" placeholder="/images/ten-anh.jpg hoặc URL http/https" class="form-control" /><span asp-validation-for="Image" class="text-danger"></span></div><div class="form-group"><label asp-for="Description"></label><textarea asp-for="Description" maxlength="350" rows="4" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
