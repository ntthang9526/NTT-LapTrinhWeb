<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - NetCoreLA7</title>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
    @await RenderSectionAsync("Css", required: false)
</head>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
    @await Component.InvokeAsync("NavTop")
    @await Component.InvokeAsync("NavLeft")
    <div class="content-wrapper">
        <section class="content-header"><div class="container-fluid"><h1>@ViewData["Title"]</h1></div></section>
        <section class="content"><div class="container-fluid">
            @if (TempData["Success"] is string message)
            {
                <div class="alert alert-success" role="status">@message</div>
            }
            @RenderBody()
        </div></section>
    </div>
    @await Component.InvokeAsync("Footer")
</div>
<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/dist/js/adminlte.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
