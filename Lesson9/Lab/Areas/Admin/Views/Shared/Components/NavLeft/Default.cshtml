@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var menus = new[] {
        (Controller: "Dashboard", Title: "Tổng quan", Icon: "tachometer-alt"),
        (Controller: "Category", Title: "Danh mục", Icon: "list"),
        (Controller: "Product", Title: "Sản phẩm", Icon: "box"),
        (Controller: "Banner", Title: "Banner", Icon: "images"),
        (Controller: "Blog", Title: "Bài viết", Icon: "newspaper")
    };
}
<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-link text-center"><span class="brand-text font-weight-light">NetCoreLA7 Admin</span></a>
    <div class="sidebar">
        <nav class="mt-3"><ul class="nav nav-pills nav-sidebar flex-column" role="menu">
        @foreach (var item in menus)
        {
            <li class="nav-item"><a asp-area="Admin" asp-controller="@item.Controller" asp-action="Index" class="nav-link @(current == item.Controller ? "active" : "")"><i class="nav-icon fas fa-@item.Icon"></i><p>@item.Title</p></a></li>
        }
        </ul></nav>
    </div>
</aside>
