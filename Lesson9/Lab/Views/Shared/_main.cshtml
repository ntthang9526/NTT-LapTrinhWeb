<!DOCTYPE html>
<html lang="vi"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - NetCoreLA7</title>
<link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
@await RenderSectionAsync("Css", required: false)
</head><body>
<nav class="navbar navbar-expand navbar-dark bg-dark"><div class="container">
<a class="navbar-brand" asp-controller="Home" asp-action="Index">NetCoreLA7</a>
<div class="navbar-nav"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a><a class="nav-link" asp-controller="Home" asp-action="About">Giới thiệu</a><a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a></div>
</div></nav>
<main class="container py-4">@RenderBody()</main>
<script src="~/plugins/jquery/jquery.min.js"></script><script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
