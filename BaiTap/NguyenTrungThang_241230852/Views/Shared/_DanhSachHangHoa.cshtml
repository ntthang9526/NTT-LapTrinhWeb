@model IEnumerable<HangHoa>

<div class="content_top">
    <div class="heading">
        <h3>@(ViewData["TieuDeHangHoa"] ?? "Nguyễn Trung Thắng")</h3>
    </div>
    <div class="clear"></div>
</div>

@if (!Model.Any())
{
    <p class="danh-sach-trong">Chưa có hàng hóa trong danh sách này.</p>
}
else
{
    <div class="section group">
        @foreach (var hang in Model)
        {
            <div class="grid_1_of_4 images_1_of_4">
                @if (!string.IsNullOrWhiteSpace(hang.Anh))
                {
                    <img src="@Url.Content("~/images/" + hang.Anh)" alt="@hang.TenHang" />
                }
                <h2>@hang.TenHang</h2>
                <div class="price-details">
                    <div class="price-number">
                        <p><span class="rupees">@(hang.Gia?.ToString("0") ?? "Chưa có giá")</span></p>
                    </div>
                    <div class="clear"></div>
                </div>
            </div>
        }
    </div>
}
