@{
    var maLoaiDangChon = ViewData["MaLoaiDangChon"] as int?;
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="header">
    <div class="header_top">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="Home Shoppe" /></a>
        </div>
        <div class="cart">
            <div>
                Welcome to our Online Store! <span>Cart:</span>
                <div class="wrapper-dropdown-2">0 item(s) - $0.00</div>
            </div>
        </div>
        <div class="clear"></div>
    </div>
    <div class="header_bottom">
        <nav class="menu" aria-label="Loại hàng">
            <ul>
                <li class="@(action == "Index" && maLoaiDangChon is null ? "active" : null)">
                    <a asp-controller="Home" asp-action="Index">Nguyễn Trung Thắng</a>
                </li>
                @if (ViewData["LoaiHangs"] is IEnumerable<LoaiHang> loaiHangs)
                {
                    foreach (var loai in loaiHangs)
                    {
                        <li class="@(maLoaiDangChon == loai.MaLoai ? "active" : null)">
                            <a asp-controller="Home" asp-action="Index" asp-route-maLoai="@loai.MaLoai"
                               data-ma-loai="@loai.MaLoai">@loai.TenLoai</a>
                        </li>
                    }
                }
                <li class="@(action == "Create" ? "active" : null)">
                    <a asp-controller="Home" asp-action="Create">Thêm hàng</a>
                </li>
            </ul>
        </nav>
        <div class="search_box">
            <form>
                <input type="text" placeholder="Search" aria-label="Tìm kiếm" />
                <input type="button" value="" aria-label="Tìm" />
            </form>
        </div>
        <div class="clear"></div>
    </div>
</div>
