@model IEnumerable<Student>
@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<a asp-route="student-add" class="btn btn-primary mb-3">Create Student</a>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Địa chỉ</th>
                <th>Email</th>
                <th>Điểm</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@(item.DateOfBorth.HasValue ? item.DateOfBorth.Value.ToString("dd/MM/yyyy") : "")</td>
                <td>@(item.Branch switch { Branch.IT => "CNTT", Branch.BE => "Kinh tế", Branch.CE => "Công trình", Branch.EE => "Điện - Điện tử", _ => "" })</td>
                <td>@(item.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(item.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@item.Address</td>
                <td>@item.Email</td>
                <td>@item.Score</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.querySelector('table').addEventListener('click', function () {
            this.classList.toggle('table-warning');
        });
    </script>
}
