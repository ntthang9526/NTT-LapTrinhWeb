@{
    ViewData["Title"] = "Product";
}
<div style="margin-inline:5%">
    <h3>Quản lý sản phẩm</h3>
    <div class="container mt-4">

        <table class="table table-borderless table-hover align-middle">
            <thead class="border-bottom border-2">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Created At</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <tr class="border-bottom">
                    <td>1</td>
                    <td>Product 1</td>
                    <td>500,000 đ</td>
                    <td>25-12-2020</td>
                    <td>
                        <img src="~/lib/Images/img1.jpg" alt="Product 1" style="width: 60px; height: 60px; object-fit: contain;" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-success btn-sm px-3">View</button>
                    </td>
                </tr>

                <tr class="border-bottom">
                    <td>2</td>
                    <td>Product 2</td>
