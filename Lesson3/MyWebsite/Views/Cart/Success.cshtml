@{
    ViewData["Title"] = "Đặt Hàng Thành Công - An Tâm Pharmacy";
    var orderCode = TempData["OrderCode"] as string ?? "AT-PHARMA-2026-001";
    var customerName = TempData["CustomerName"] as string ?? "Khách Hàng";
    var customerPhone = TempData["CustomerPhone"] as string ?? "";
    var customerAddress = TempData["CustomerAddress"] as string ?? "";
    var totalAmount = TempData["TotalAmount"] as string ?? "";
    var totalItems = TempData["TotalItems"] as string ?? "1";
    var paymentMethod = TempData["PaymentMethod"] as string ?? "COD";
    var methodText = paymentMethod switch
    {
        "COD" => "Thanh toán tiền mặt khi nhận hàng (COD)",
        "QR_TRANSFER" => "Chuyển khoản ngân hàng VietQR",
        "VNPAY" => "Ví điện tử VNPAY / Thẻ ngân hàng",
        _ => "Thanh toán khi nhận hàng"
    };
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                <!-- Top Header Banner -->
                <div class="p-5" style="background: linear-gradient(135deg, #0f766e 0%, #0284c7 100%); color: white;">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle" style="width: 80px; height: 80px;">
                            <i class="bi bi-check-lg text-success" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h2 class="fw-extrabold mb-2">ĐẶT HÀNG THÀNH CÔNG!</h2>
                    <p class="fs-6 opacity-90 mb-0">Cảm ơn bạn đã tin tưởng lựa chọn Nhà Thuốc An Tâm Pharmacy</p>
                </div>

                <!-- Body Details -->
                <div class="card-body p-4 p-md-5 text-start">
                    <div class="alert alert-success d-flex align-items-center gap-3 mb-4 rounded-3">
                        <i class="bi bi-telephone-inbound-fill fs-3 text-success"></i>
                        <div>
                            <strong>Thông báo từ Dược sĩ:</strong> Đơn thuốc của bạn đã được chuyển tới quầy Dược sĩ phụ trách. Chúng tôi sẽ gọi tới số <strong>@customerPhone</strong> trong vòng 15 phút để tư vấn và xác nhận trước khi đóng gói.
                        </div>
                    </div>

                    <!-- Order Code & Summary Box -->
                    <div class="bg-light p-4 rounded-3 border mb-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Mã đơn hàng:</span>
                                <strong class="fs-5 text-teal text-uppercase">@orderCode</strong>
                            </div>
                            <div class="col-sm-6 text-sm-end">
                                <span class="text-muted small d-block">Tổng tiền thanh toán:</span>
                                <strong class="fs-4 text-danger">@totalAmount</strong>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="row g-3 small">
                            <div class="col-md-6">
                                <span class="text-muted">Người nhận:</span>
                                <div class="fw-bold text-dark">@customerName (@customerPhone)</div>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted">Hình thức thanh toán:</span>
                                <div class="fw-bold text-dark">@methodText</div>
                            </div>
                            <div class="col-12">
                                <span class="text-muted">Địa chỉ nhận hàng:</span>
                                <div class="fw-bold text-dark">@customerAddress</div>
                            </div>
                        </div>
                    </div>

                    <!-- Process Steps -->
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-teal me-2"></i>Quy Trình Xử Lý Đơn Thuốc</h6>
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <i class="bi bi-clipboard2-pulse text-teal fs-3 mb-1 d-block"></i>
                                <span class="small fw-bold d-block">1. Tiếp nhận & Dược sĩ duyệt</span>
                                <span class="text-muted" style="font-size: 0.72rem;">Đang xử lý</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <i class="bi bi-box2-heart text-primary fs-3 mb-1 d-block"></i>
                                <span class="small fw-bold d-block">2. Đóng gói chuẩn GPP</span>
                                <span class="text-muted" style="font-size: 0.72rem;">Nhiệt độ 20-25°C</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <i class="bi bi-truck text-warning fs-3 mb-1 d-block"></i>
                                <span class="small fw-bold d-block">3. Giao hàng hỏa tốc</span>
                                <span class="text-muted" style="font-size: 0.72rem;">2h nội thành</span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                            <i class="bi bi-house-door me-1"></i> Về Trang Chủ
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-teal text-white px-4 fw-bold shadow">
                            <i class="bi bi-bag-plus me-1"></i> Tiếp Tục Mua Thuốc
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
