@using MyWebsite.Helpers
@using MyWebsite.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    // Lấy giỏ hàng từ Session để hiển thị số lượng tức thì trên badge
    var sessionCart = HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<CartItem>>("PHARMACY_CART_SESSION");
    int cartCount = sessionCart?.Sum(x => x.Quantity) ?? 0;
    var categories = MockRepository.GetCategories();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - An Tâm Pharmacy | Hệ Thống Nhà Thuốc Chuẩn GPP</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Pharmacy CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Category Dimmed Backdrop Overlay (Bôi đen phần bên ngoài khi ấn danh mục) -->
    <div id="categoryBackdrop" class="category-backdrop"></div>

    <!-- Main Navigation Header (Bao gồm top-bar chuẩn GPP trên Desktop) -->
    <header class="sticky-top pharmacy-main-header">
        <!-- Top Utility Bar -->
        <div class="top-bar d-none d-md-block">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-4">
                    <span><i class="bi bi-shield-check text-warning me-1"></i> Hệ thống nhà thuốc đạt chuẩn GPP - Bộ Y Tế</span>
                    <span><i class="bi bi-truck text-info me-1"></i> Miễn phí vận chuyển cho đơn hàng từ 300.000đ</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="tel:18006868"><i class="bi bi-telephone-fill text-warning me-1"></i> Hotline Dược sĩ: <strong>1800 6868</strong> (Miễn phí 24/7)</a>
                    <span>|</span>
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-geo-alt-fill me-1"></i> Tìm nhà thuốc gần bạn</a>
                </div>
            </div>
        </div>

        <div class="bg-white pharmacy-navbar">
        <div class="container">
            <div class="row align-items-center g-3">
                <!-- Brand Logo -->
                <div class="col-6 col-lg-3">
                    <a class="brand-logo" asp-controller="Home" asp-action="Index">
                        <div class="brand-icon">
                            <i class="bi bi-plus-circle-fill"></i>
                        </div>
                        <div>
                            <h1 class="brand-title">An Tâm</h1>
                            <p class="brand-subtitle">Online Pharmacy</p>
                        </div>
                    </a>
                </div>

                <!-- Search Bar Form (GET to /Product) -->
                <div class="col-12 col-lg-6 order-3 order-lg-2">
                    <form method="get" asp-controller="Product" asp-action="Index" class="search-form-header">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control" 
                                   placeholder="Tìm tên thuốc, triệu chứng, vitamin, thiết bị y tế..." 
                                   value="@Context.Request.Query["search"]" />
                            <button class="btn" type="submit">
                                <i class="bi bi-search me-1"></i> Tìm kiếm
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Header Actions & Cart -->
                <div class="col-6 col-lg-3 text-end order-2 order-lg-3 d-flex justify-content-end align-items-center gap-2">
                    <a asp-controller="Cart" asp-action="Index" class="btn-cart-nav" title="Xem giỏ hàng thuốc">
                        <i class="bi bi-bag-check-fill fs-5"></i>
                        <span class="d-none d-sm-inline">Giỏ hàng</span>
                        <span class="badge-cart-count" id="cartBadgeCount">@cartCount</span>
                    </a>
                </div>
            </div>

            <!-- Categories Nav Menu Bar -->
            <nav class="navbar navbar-expand-lg navbar-light p-0 mt-2 border-top pt-2 position-relative">
                <button class="navbar-toggler w-100 mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#pharmacyNav">
                    <span class="navbar-toggler-icon"></span> <span class="ms-2 fs-6 fw-bold">Danh Mục Sản Phẩm</span>
                </button>
                <div class="collapse navbar-collapse" id="pharmacyNav">
                    <!-- Mobile Header inside popup with close button -->
                    <div class="d-flex justify-content-between align-items-center d-lg-none mb-3 pb-2 border-bottom">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-grid-fill text-teal me-2"></i>Danh Mục Sản Phẩm</h6>
                        <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#pharmacyNav" aria-label="Close"></button>
                    </div>

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-medical" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill text-primary me-1"></i> Trang Chủ
                            </a>
                        </li>
                        
                        <!-- Dropdown Danh mục sản phẩm -->
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-link-medical dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-fill text-success me-1"></i> Danh Mục Sản Phẩm
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="categoryDropdown">
                                <li>
                                    <a class="dropdown-item py-2 fw-semibold" asp-controller="Product" asp-action="Index">
                                        <i class="bi bi-collection text-primary me-2"></i> Tất Cả Sản Phẩm
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @foreach (var cat in categories)
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id">
                                            <i class="bi @cat.Icon text-teal me-2"></i> @cat.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link nav-link-medical" asp-controller="Product" asp-action="Index" asp-route-sortOrder="bestseller">
                                <i class="bi bi-fire text-danger me-1"></i> Thuốc Bán Chạy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-medical" asp-controller="Product" asp-action="Index" asp-route-categoryId="3">
                                <i class="bi bi-heart-pulse-fill text-info me-1"></i> Vitamin & TPCN
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-medical" asp-controller="Product" asp-action="Index" asp-route-categoryId="6">
                                <i class="bi bi-bandaid-fill text-warning me-1"></i> Dụng Cụ Y Tế
                            </a>
                        </li>
                    </ul>
                    <div class="d-none d-xl-flex align-items-center text-muted small">
                        <i class="bi bi-patch-check-fill text-success me-1"></i> Cam kết 100% thuốc chính hãng
                    </div>
                </div>
            </nav>
        </div>
        </div>
    </header>

    <!-- Flash Messages (TempData) -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Footer Standard Medical -->
    <footer class="pharmacy-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Col 1: Giới thiệu & Pháp lý -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon" style="width: 36px; height: 36px; font-size: 1.2rem;">
                            <i class="bi bi-plus-circle-fill"></i>
                        </div>
                        <h4 class="text-white m-0 fw-bold">An Tâm Pharmacy</h4>
                    </div>
                    <p class="small text-secondary mb-3">
                        Hệ thống nhà thuốc tiện lợi và đáng tin cậy hàng đầu. Đội ngũ Dược sĩ Đại học chuyên môn cao luôn túc trực tư vấn dùng thuốc an toàn, hiệu quả.
                    </p>
                    <div class="small text-secondary mb-2">
                        <i class="bi bi-geo-alt me-2 text-info"></i> Tầng 5, Tòa nhà Y Dược Quốc Tế, Hà Nội
                    </div>
                    <div class="small text-secondary mb-2">
                        <i class="bi bi-telephone me-2 text-warning"></i> Tổng đài tư vấn: <strong>1800 6868</strong>
                    </div>
                    <div class="small text-secondary">
                        <i class="bi bi-envelope me-2 text-success"></i> Email: hotro@nhathuocantam.vn
                    </div>
                </div>

                <!-- Col 2: Danh mục nhanh -->
                <div class="col-lg-2 col-md-6">
                    <h5>Danh Mục</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        @foreach (var cat in categories.Take(5))
                        {
                            <li>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id">
                                    @cat.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Col 3: Chính sách & Tiêu chuẩn -->
                <div class="col-lg-3 col-md-6">
                    <h5>Chính Sách & Hỗ Trợ</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="#"><i class="bi bi-arrow-right-short"></i> Chính sách đổi trả trong 30 ngày</a></li>
                        <li><a href="#"><i class="bi bi-arrow-right-short"></i> Giao hàng hỏa tốc trong 2 giờ</a></li>
                        <li><a href="#"><i class="bi bi-arrow-right-short"></i> Hướng dẫn đặt thuốc trực tuyến</a></li>
                        <li><a href="#"><i class="bi bi-arrow-right-short"></i> Cam kết bảo mật hồ sơ sức khỏe</a></li>
                        <li><a href="#"><i class="bi bi-arrow-right-short"></i> Quy trình kiểm duyệt thuốc Bộ Y Tế</a></li>
                    </ul>
                </div>

                <!-- Col 4: Giả lập chứng nhận Y Tế -->
                <div class="col-lg-3 col-md-6">
                    <h5>Chứng Nhận Y Tế</h5>
                    <p class="small text-secondary mb-3">Tuân thủ nghiêm ngặt các quy định của Cục Quản Lý Dược - Bộ Y Tế Việt Nam.</p>
                    
                    <div class="d-flex flex-wrap">
                        <div class="badge-medical-cert">
                            <i class="bi bi-patch-check-fill text-success"></i> Đạt chuẩn GPP
                        </div>
                        <div class="badge-medical-cert">
                            <i class="bi bi-shield-lock-fill text-info"></i> FDA Standards
                        </div>
                        <div class="badge-medical-cert">
                            <i class="bi bi-award-fill text-warning"></i> ISO 9001:2015
                        </div>
                        <div class="badge-medical-cert">
                            <i class="bi bi-capsule text-primary"></i> 100% Chính Hãng
                        </div>
                    </div>

                    <div class="mt-3">
                        <span class="small text-secondary d-block mb-1">Phương thức thanh toán an toàn:</span>
                        <div class="d-flex gap-2 fs-5 text-secondary">
                            <i class="bi bi-credit-card-2-front" title="Thẻ Visa/Mastercard"></i>
                            <i class="bi bi-cash-stack" title="Thanh toán khi nhận hàng (COD)"></i>
                            <i class="bi bi-qr-code" title="Chuyển khoản QR"></i>
                            <i class="bi bi-wallet2" title="Ví điện tử VNPAY / Momo"></i>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <div class="row align-items-center small text-secondary">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    &copy; 2026 <strong>An Tâm Pharmacy</strong>. Toàn bộ thông tin y khoa đều được cố vấn bởi Dược sĩ chuyên môn.
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span>GPKD số: 0102938475 do Sở Kế hoạch & Đầu tư cấp | GCN Đủ ĐK Kinh Doanh Dược số: 489/ĐKKDD-BYT</span>
                </div>
            </div>
        </div>
    <!-- Toast Notification Container for AJAX actions -->
    <div id="toastNotificationContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090; margin-top: 70px;"></div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
