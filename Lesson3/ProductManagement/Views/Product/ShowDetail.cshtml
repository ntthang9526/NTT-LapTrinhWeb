    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var product = ViewBag.product;
    ViewData["Title"] = product.Name;
}
<h2>THÔNG TIN SẢN PHẨM</h2>
<div class="row">
    <div class="col-md-4">
        <img src="@product.Image" class="img-fluid" />
    </div>
    <div class="col-md-8">
        <h2>Tên sản phẩm: @product.Name</h2>
        <h3>Giá gốc: <span class="text-decoration-line-through " style="color:red">@product.Price</span></h3>
        <h3>Giá mới: <span style="color:limegreen">@product.SalePrice</span></h3>
        <div>
            <h3>Mô tả:</h3>
            <p>@product.Description</p>
        </div>
        <h3>Trạng thái: @product.GetStatus()</h3>
        <h3>Ngày đăng: @product.CreatedAt.ToString("dd/MM/yyyy")</h3>
        <a asp-route="products"><btn class="btn btn-danger">Quay lại</btn></a>
    </div>
</div>
