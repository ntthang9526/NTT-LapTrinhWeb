    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var products = ViewBag.products;
    List<Category> categories = ViewBag.categories;
    ViewData["Title"] = categories.FirstOrDefault(cate => cate.ID == products[0].CategoryID).Name;
}
<div class="row">
    <div class="col col-md-3">
        <a asp-route="products" class="text-decoration-none text-black"><h3>DANH MỤC</h3></a>
        <div class="list-group">
            @foreach (var category in categories)
            {
                <a asp-route="category" asp-route-id="@category.ID" class="list-group-item list-group-item-action">@category.Name</a>
            }
        </div>
    </div>
    <div class="col col-md-9">
        <div class="row">
            @foreach (var product in products)
            {
                <div class="col-md-3">
                    <div class="img-thumbnail">
                        <div class="ratio ratio-1x1">
                            <img src="@product.Image" alt="" class="img-fluid object-fit-cover" style="" />
                        </div>
                        <div class="figure-caption text-black">
                            <h4 class="line-clamp-2" style="height:60px">@product.Name</h4>
                            <p>Giá: <span class="text-decoration-line-through">@product.Price</span> @product.SalePrice</p>
                            <a asp-route="product-detail" asp-route-id="@product.ID" class="btn btn-success d-block">Chi tiết sản phẩm</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>