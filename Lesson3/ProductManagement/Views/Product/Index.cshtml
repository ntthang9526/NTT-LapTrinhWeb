@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var products = ViewBag.products;
    var categories = ViewBag.categories;
}
<div class="row">
    <div class="col col-md-3">
        <a asp-route="products" class="text-decoration-none text-black"><h3>DANH MỤC</h3></a>
        <div class="list-group">
            @foreach (var category in categories)
            {
                <a asp-route="category" asp-route-id="@category.ID" class="list-group-item list-group-item-action">@category.Name</a>
            }
        </div>
    </div>
    <div class="col col-md-9">
        <div class="row">
            @foreach (var product in products)
            {
                <div class="col-md-3">
                    <partial name="_ProductCard" model="product"></partial>
                </div>
            }
        </div>
    </div>
</div>