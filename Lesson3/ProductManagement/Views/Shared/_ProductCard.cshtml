@{
}
@model Product
<div class="img-thumbnail">
    <div class="ratio ratio-1x1">
        <img src="@Model.Image" alt="" class="img-fluid object-fit-cover" style="" />
    </div>
    <div class="figure-caption text-black">
        <h4 class="line-clamp-2" style="height:60px">@Model.Name</h4>
        <p>Giá: <span class="text-decoration-line-through">@Model.Price</span> @Model.SalePrice</p>
        <a asp-route="product-detail" asp-route-id="@Model.ID" class="btn btn-success d-block">Chi tiết sản phẩm</a>
    </div>
</div>
