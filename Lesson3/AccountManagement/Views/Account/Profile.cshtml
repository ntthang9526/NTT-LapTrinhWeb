@{
    ViewData["Title"] = "Profile";
    var account = ViewBag.account;
}
<h2>Profile</h2>
<div class="row">
    <div class="col-md-4">
        <img src="@account.Avatar" class="img-fluid"/>
    </div>
    <div class="col-md-8">
        <h2>Full Name: @account.Name</h2>
        <h3>Email: @account.Email</h3>
        <h3>Phone: @account.Phone</h3>
        <h3>Address: @account.Address</h3>
        <h3>Bio: @account.Bio</h3>
        <h3>Gender:
            @if (account.Gender == 1)
            {
                <span>Male</span>
            }
            else if (account.Gender == 2)
            {
                <span>Female</span>
            }
            else {<span>Other</span>  }      
        </h3>
        <h3>Birthday: @account.Birthday.ToString("dd/MM/yyyy")</h3>
        <a asp-route="account" ><btn class="btn btn-danger">Back to list</btn></a>
    </div>
</div>

