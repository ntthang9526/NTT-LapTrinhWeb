@{
}
<div>
    <h2>Danh sách sản phẩm</h2>
    <table class="table table-bordered">
        <thead>
            <tr>
                <td>Mã sản phẩm</td>
                <td>Tên sản phẩm</td>
                <td>Năm</td>
                <td>Giá</td>
            </tr>
        </thead>
        <tbody>
            @foreach(var p in ViewBag.products)
            {
                <tr>
                    <td>@p.ID</td>
                    <td>@p.Name</td>
                    <td>@p.YearRelease</td>
                    <td>@p.Price</td>
                </tr>
            }
        </tbody>
    </table>
</div>
