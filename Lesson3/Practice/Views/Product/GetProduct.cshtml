@{
    ViewData["Title"] = "GetProduct";
}
<div>
    <h2>Dữ liệu lấy ra từ ViewBag</h2>
    <p>Mã sản phẩm: @ViewBag.product.ID</p>
    <p>Tên sản phẩm: @ViewBag.product.Name</p>
    <p>Năm: @ViewBag.product.YearRelease</p>
    <p>Giá: @ViewBag.product.Price</p>
</div>
@{
    var product = ViewData["product"] as Practice.Models.Product;
}
<div>
    <h2>Dữ liệu lấy ra từ ViewData</h2>
    <p>Mã sản phẩm: @product.ID</p>
    <p>Tên sản phẩm: @product.Name</p>
    <p>Năm: @product.YearRelease</p>
    <p>Giá: @product.Price</p>
</div>
