@model IEnumerable<Lab1.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-route="student-add" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Mã
            </th>
            <th>
                Họ tên
            </th>
            <th>
                Ngày sinh
            </th>
            <th>
                Ngành
            </th>
            <th>
                Giới tính
            </th>
            <th>
                Hệ ĐT
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Ngày sinh
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
                @{
                    string text = "";
                    switch (item.Branch)
                    {
                        case Branch.IT:
                            text = "CNTT";
                            break;
                        case Branch.BE:
                            text = "Kinh tế";
                            break;
                        case Branch.CE:
                            text = "Công trình";
                            break;
                        case Branch.EE:
                            text = "Điện - Điện tử";
                            break;
                    }
            }
            <td>
                @Html.DisplayFor(model => text)
            </td>
            <td>
                @(item.Gender == Gender.Male? "Nam" : "Nữ") 
            </td>
            <td>
                @(item.IsRegular? "Chính quy" : "Phi chính quy")
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateOfBorth)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
