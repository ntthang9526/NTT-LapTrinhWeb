@model Student
@{
    ViewData["Title"] = "Create Student";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<div class="container mt-4">
    <form asp-route="student-add" method="post">
        <!-- Họ tên -->
        <div class="row mb-3">
            <label asp-for="Name" class="col-sm-2 col-form-label">Họ tên</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <!-- Email -->
        <div class="row mb-3">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" type="email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <!-- Mật khẩu -->
        <div class="row mb-3">
            <label asp-for="Password" class="col-sm-2 col-form-label">Mật khẩu</label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <!-- Ngành học -->
        <div class="row mb-3">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành</label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select" asp-items="Html.GetEnumSelectList<Branch>()">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10 d-flex align-items-center">
                @foreach (var gender in Html.GetEnumSelectList<Gender>())
                {
                    <div class="form-check form-check-inline">
                        <input type="radio" asp-for="Gender" value="@gender.Value" id="gender_@gender.Value" class="form-check-input" />
                        <label class="form-check-label" for="gender_@gender.Value">@gender.Text</label>
                    </div>
                }
                <span asp-validation-for="Gender" class="text-danger ms-2"></span>
            </div>
        </div>

        <!-- Hệ chính quy -->
        <div class="row mb-3">
            <label class="col-sm-2 col-form-label">Hệ đào tạo</label>
            <div class="col-sm-10 d-flex align-items-center">
                <div class="form-check">
                    <input asp-for="IsRegular" class="form-check-input" type="checkbox" id="IsRegularCheck" />
                    <label class="form-check-label" for="IsRegularCheck">Chính quy</label>
                </div>
            </div>
        </div>

        <!-- Ngày sinh -->
        <div class="row mb-3">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBorth" class="text-danger"></span>
            </div>
        </div>

        <!-- Địa chỉ -->
        <div class="row mb-3">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <input asp-for="Address" class="form-control" placeholder="Địa chỉ" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="row">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary px-4">Create</button>
            </div>
        </div>
    </form>
</div>
